# Templated by the official nginx image's docker-entrypoint at container
# start: every ${VAR} below that matches an actual environment variable on
# the container gets substituted (envsubst), everything else — nginx's own
# $host, $uri, etc. — is left alone. Output lands at
# /etc/nginx/conf.d/app.conf. Set DOMAIN via the root .env file (see
# docker-compose.yml).

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Let's Encrypt's HTTP-01 challenge — must be reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Canonicalize straight to the apex over https, whichever host was hit.
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    # www is accepted here (needs a valid cert for the browser to even show
    # the redirect below) but always bounced to the apex — ALLOWED_ORIGINS
    # on the backend only lists the apex, so two live origins would just be
    # two CORS/CSRF exceptions to keep in sync for no benefit.
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # www gets a valid cert (above) so the browser will trust this redirect
    # instead of showing a cert-mismatch warning first. This `if` is one of
    # the few nginx endorses despite "if is evil" — a single condition, no
    # nested location logic.
    if ($host = www.${DOMAIN}) {
        return 301 https://${DOMAIN}$request_uri;
    }

    # Set at server level, not inside location /, so every location below
    # (including the exact-match /index.html one) inherits it — root does
    # not inherit between sibling location blocks, only down from an
    # enclosing server/http block.
    root /usr/share/nginx/html;

    # Same header set as the previous webapp/vercel.json, so moving off
    # Vercel doesn't relax anything. The app's own CSP travels in the built
    # HTML's <meta> tag (see webapp/vite-csp-plugin.ts) and doesn't belong
    # here — frame-ancestors below is the one directive a <meta> tag cannot
    # carry, which is exactly why it has to live at this layer.
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(self), screen-wake-lock=(), usb=(), xr-spatial-tracking=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;
    add_header Origin-Agent-Cluster "?1" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Reverse-proxy to the backend container. No path rewrite — proxy_pass
    # has no URI segment after the host, so nginx forwards the original
    # /api/... path unchanged, matching how the backend mounts its routers
    # (app.route("/api/...", ...)). This keeps the browser talking to a
    # single origin, exactly like the old Vercel rewrite to Render did — so
    # the existing SameSite=Lax + __Host- cookie + CSRF design needs no
    # changes.
    location /api/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }

    location / {
        try_files $uri /index.html;
    }
}
