# Root-level env — read by docker-compose.yml, NOT by the app itself.
# Copy to `.env` on the VPS (gitignored, never commit the real value).

# The domain this deployment serves, e.g. app.getpaybridge.com
# Used to template deploy/nginx/app.conf.template and to request the
# Let's Encrypt certificate in deploy/init-letsencrypt.sh.
DOMAIN=
