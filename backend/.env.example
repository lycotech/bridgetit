# PayBridge backend — environment variables
#
# Copy to `.env` and fill in. NEVER commit the filled-in file: .gitignore now
# blocks `.env` and `.env.*`, and only this example is tracked.
#
# In production, set these in Render's dashboard (or via render.yaml's
# `sync: false` envVars) rather than in a file — that keeps them out of the
# repository entirely, which is the point.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000

# development | production
# WHY it matters for security, not just logging: NODE_ENV=production turns on
# HSTS, the `__Host-` cookie prefix, the Secure cookie flag, and makes
# SESSION_SECRET and LOG_SALT mandatory. A production deployment left at
# "development" silently runs with dev-grade session security.
NODE_ENV=development

# Public origin of this API. Used for cookie/redirect correctness.
BACKEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Secrets — REQUIRED in production, validated at boot (src/env.ts)
# ---------------------------------------------------------------------------

# Signing key for session cookies. Minimum 32 characters.
#   Generate:  openssl rand -base64 48
# WHY there is no default: a default signing key is a published signing key.
# Anyone who reads the source could forge an administrator session offline,
# with no network attack and nothing in the logs. The server refuses to start
# in production without it, so the failure is an outage rather than a breach.
SESSION_SECRET=

# Key for AES-256-GCM encryption of KYC identity fields (ID number, date of
# birth, address, BVN) and administrator TOTP secrets. Minimum 32 characters.
#   Generate:  openssl rand -base64 48
# WHY this one matters more than the others: it is the only secret whose loss
# destroys data rather than merely weakening a control. Every encrypted KYC
# record becomes permanently unreadable if it changes, and the affected
# customers have to submit their identity documents again. There is no
# re-encryption path. Set it once, back it up, never rotate it casually.
KYC_ENCRYPTION_KEY=

# Salt for the one-way pseudonyms used in audit logs. Minimum 16 characters.
#   Generate:  openssl rand -base64 24
# WHY salted rather than plain hashing: an unsalted hash of an email address is
# reversible by anyone with a list of candidate emails — which is everyone.
# The salt keeps the audit trail linkable (same person = same pseudonym) while
# staying non-reversible, so logs remain useful for investigations without
# becoming a second copy of the customer database.
LOG_SALT=

# ---------------------------------------------------------------------------
# Origins
# ---------------------------------------------------------------------------
# Comma-separated EXACT extra origins allowed to call this API with cookies.
# The built-in list only covers localhost/127.0.0.1 for local dev — production
# origins (your Vercel domain(s)) MUST be listed here.
# WHY exact origins and not a wildcard: this list drives both CORS and CSRF
# origin pinning. One over-broad entry re-opens cross-site request forgery for
# every authenticated route at once.
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,https://getpaybridge.com
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL: Neon's POOLED connection string. The app queries through this
# one at runtime.
#   Get it from: Neon dashboard → your project → Connection Details →
#   "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.region.aws.neon.tech/dbname?sslmode=require"

# DIRECT_URL: Neon's UNPOOLED connection string. Only `prisma migrate` uses
# this — schema migrations need a direct connection, not one behind PgBouncer.
#   Get it from: the same Connection Details panel → "Direct connection"
DIRECT_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# KYC document storage — S3-compatible object storage
# ---------------------------------------------------------------------------
# Works with AWS S3, Cloudflare R2, or Backblaze B2. Only KYC_S3_ENDPOINT and
# KYC_S3_FORCE_PATH_STYLE are needed for a non-AWS provider.
KYC_S3_BUCKET=
KYC_S3_REGION=
KYC_S3_ACCESS_KEY_ID=
KYC_S3_SECRET_ACCESS_KEY=
# e.g. https://<account-id>.r2.cloudflarestorage.com (Cloudflare R2)
KYC_S3_ENDPOINT=
# "true" for R2/B2/MinIO, leave unset for AWS S3.
KYC_S3_FORCE_PATH_STYLE=

# ---------------------------------------------------------------------------
# Third-party keys (optional — the feature is optional)
# ---------------------------------------------------------------------------
# Format-checked at boot so a truncated or placeholder value fails at startup
# instead of halfway through a user's request.
OPENAI_API_KEY=

# Anthropic (Claude) key for the real AI Assistant chat on the customer
# /account page (backend/src/routes/ai-assistant.ts). Get one from
# console.anthropic.com. Without it, the chat endpoint returns a clear
# "not configured" error instead of failing mid-request.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Outbound email — the four PayBridge identities
# ---------------------------------------------------------------------------
# ALL of this is server-side only. Credentials must never reach the frontend
# bundle: the browser posts to /api/registrations/*, and this process is the
# only thing that ever holds an SMTP password or an API key.
#
# If NOTHING below is set the mailer falls back to a log-only transport. That
# is deliberate: an unconfigured mail server must never turn a captured lead
# into a 500 the visitor retries. Registrations are still stored; only the
# acknowledgement is skipped, and the skip is written to the audit log.

# smtp | resend | log   (auto-detected if omitted)
MAIL_TRANSPORT=

# --- Option A: SMTP -------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# ssl = implicit TLS (port 465), starttls = upgrade (port 587), none = dev only
# WHY this is explicit: a STARTTLS connection that silently falls back to
# plaintext sends the password and the registrant's details in the clear. On
# "starttls" the transport sets requireTLS, so the send fails instead.
SMTP_SECURE=starttls

# --- Option B: Resend (HTTP, no SMTP port needed) -------------------------
RESEND_API_KEY=

# --- Sender identities and internal inboxes -------------------------------
# Defaults are the four production addresses; override to route a staging
# deployment at a test mailbox.
#
#   General / contact form / media      PayBridge Team          hello@getpaybridge.com
#   Employee (Bridger) waitlist         PayBridge Bridgers      bridgers@getpaybridge.com
#   Employer registrations / pilots     PayBridge Partnerships  partners@getpaybridge.com
#   Capital partnership enquiries       PayBridge Capital       capital@getpaybridge.com
#
# NOTE the plural: partners@getpaybridge.com. partner@ is NOT an alias.
MAIL_FROM_GENERAL=hello@getpaybridge.com
MAIL_FROM_EMPLOYEE=bridgers@getpaybridge.com
MAIL_FROM_EMPLOYER=partners@getpaybridge.com
MAIL_FROM_CAPITAL=capital@getpaybridge.com
MAIL_INBOX_GENERAL=hello@getpaybridge.com
MAIL_INBOX_EMPLOYEE=bridgers@getpaybridge.com
MAIL_INBOX_EMPLOYER=partners@getpaybridge.com
MAIL_INBOX_CAPITAL=capital@getpaybridge.com
# Address published for data-access, deletion and breach-report requests.
MAIL_PRIVACY_CONTACT=hello@getpaybridge.com

# ---------------------------------------------------------------------------
# Admin dashboard  (NOT public — no self-service registration exists)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=

# sha256(password) as hex:
#   printf '%s' 'your-password' | sha256sum
# WHY a hash: this value sits in a deployment config that CI reads, dashboards
# display and people paste into chat. A hash there is still sensitive but is
# not directly replayable against anything the person reuses elsewhere.
ADMIN_PASSWORD_HASH=

# Plaintext, DEVELOPMENT ONLY. The server refuses to authenticate against it
# when NODE_ENV=production.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Private demonstration environment
# ---------------------------------------------------------------------------
# The demo has NOT been deleted — it is gated. Normal access is a unique,
# expiring, single-use invitation link issued by hand from the admin dashboard
# after an employer qualifies. This shared code is the fallback for a live
# meeting; leave it blank to disable code entry entirely.
DEMO_ACCESS_CODE=

# Base URL used when minting invitation links. Must be one of the allowlisted
# hosts (see routes/admin.ts::resolveBaseUrl).
# WHY allowlisted: an admin session that could set an arbitrary base would mint
# a PayBridge-branded email containing a link to someone else's host — a
# phishing kit with our letterhead on it.
DEMO_BASE_URL=https://demo.getpaybridge.com
